    "next": "latest",
    "openai": "^7.43.0",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tsx": "latest",
    "typescript": "^5.9.0"
  },
  "engines": {
