# Copy this file to .env or .env.local. Never use NEXT_PUBLIC_ for these values.
# Set either editor key. With no LLM_PROVIDER, Claude is selected if its key is
# present; otherwise OpenAI is selected if its key is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/rag-web-browser

# Optional: defaults to the current Sonnet model below. Must support structured JSON output.
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5.4-mini
# Optional explicit choice: openai or anthropic. No switching on API failures.
# LLM_PROVIDER=openai

# Optional for apify/rag-web-browser, REQUIRED for every other Actor.
# Use the exact JSON input accepted by your Actor. Unset uses a rolling seven-day
# news search with article extraction. This is server configuration, not user input.
# APIFY_ACTOR_INPUT_JSON={"query":"recent science news after:2026-10-17","maxResults":10,"outputFormats":["markdown"],"requestTimeoutSecs":60}
