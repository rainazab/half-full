# Copy this file to .env or .env.local. Never use NEXT_PUBLIC_ for these values.
# Claude is the default editor. No OpenAI key is required or used.
ANTHROPIC_API_KEY=
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apify/rag-web-browser
LLM_PROVIDER=anthropic

# Optional model override. Must support structured JSON output.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional for apify/rag-web-browser, REQUIRED for every other Actor.
# Use the exact JSON input accepted by your Actor. Unset uses a rolling seven-day
# news search with article extraction. This is server configuration, not user input.
# APIFY_ACTOR_INPUT_JSON={"query":"recent science news after:2026-10-17","maxResults":10,"outputFormats":["markdown"],"requestTimeoutSecs":60}

# Optional narration. The written edition still works without Cartesia.
CARTESIA_API_KEY=
# Existing deployments using CARTESIA as the key name are also supported.
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# CARTESIA_MODEL_ID=sonic-3.6

# Optional article images: each approved story's publisher share image (og:image),
# hotlinked with attribution as a link preview. Set to false to show illustrations only.
# ARTICLE_IMAGES_ENABLED=true

# Optional public Reddit context: one bounded batch after editorial selection.
# Enabled by default; requires Actor access/credits on the same Apify account.
APIFY_SOCIAL_ENABLED=true
APIFY_SOCIAL_ACTOR_ID=apify/reddit-scraper
# Custom Actors need their own compatible JSON input; US injects searchQueries.
# They must support batched searchQueries and return Reddit post fields.
# APIFY_SOCIAL_ACTOR_INPUT_JSON={"scrapeMode":"posts","maxSearchResultsPerQuery":3,"searchSort":"relevance","searchTimeFilter":"week","includeNsfw":false}
