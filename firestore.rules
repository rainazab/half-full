rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasAll(['displayName','email','photoURL','days','reactions','updatedAt'])
          && data.keys().hasOnly(['displayName','email','photoURL','days','reactions','updatedAt'])
          && data.displayName is string && data.displayName.size() <= 256
          && data.email is string && data.email.size() <= 320
          && data.photoURL is string && data.photoURL.size() <= 2048
          && data.days is list && data.days.size() <= 366
          && data.reactions is map && data.reactions.size() <= 1000
          && data.reactions.values().hasOnly(['Interesting','Insightful','Hopeful','Stressed','Clearer','A lot',''])
          && data.updatedAt == request.time;
      }
      allow get: if owner();
      allow list: if false;
      allow create, update: if owner() && validProfile();
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
